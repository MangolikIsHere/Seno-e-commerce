# ==============================================================================
# SENO LUXURY MARKETPLACE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Never commit production credentials, secret keys, or service role tokens.

# 1. Supabase Public Client Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# 2. Supabase Privileged Server Credential (STRICTLY SERVER-SIDE / NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. Razorpay Payment Gateway Credentials
# Only NEXT_PUBLIC_RAZORPAY_KEY_ID is exposed to the client bundle.
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are strictly server-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 3. Canonical Domain & Production Site URL
NEXT_PUBLIC_SITE_URL=https://seno-luxury.com